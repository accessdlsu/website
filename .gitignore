# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
package-lock.json
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/certificates

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
._*
*.pem

# local code intelligence / analysis caches
.codegraph/
.fallow/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/
wrangler.toml

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare generated types (npm run cf-typegen)
/env.d.ts
